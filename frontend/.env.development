# Développement uniquement — non utilisé par le build de production.
#
# En dev, Vite sert le front sur le port 5173 tandis que FastAPI écoute sur le
# port 8000 : ce sont deux origines distinctes, il faut donc désigner l'API
# explicitement. En production ces variables restent vides et les URL
# deviennent relatives (cf. src/lib/config.ts).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
